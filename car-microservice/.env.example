# --- source site ---
# See docs/ckauto-api.md. Paths default to the values below; set them only
# if CKAuto moves an endpoint.
SOURCE_BASE_URL=https://ckauto.co.kr
# SOURCE_CSRF_PATH=/api/auth/csrf
# SOURCE_LOGIN_PATH=/api/auth/login
# SOURCE_STATE_PATH=/api/app/state
# Partner account: SOURCE_USERNAME is CKAuto's loginId.
SOURCE_USERNAME=
SOURCE_PASSWORD=

# Lots carry up to 138 photos; only the first N are copied to Cloudinary.
# The channel post shows the first 10.
MAX_IMAGES_PER_VEHICLE=20

# politeness: pause after every request, including each photo
REQUEST_DELAY_MS=1500

# --- infra ---
MONGODB_URI=mongodb://localhost:27017/auto-auction

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=ckauto

# --- admin API ---
# Bearer token the admin panel presents. Min 16 chars; unset = all admin
# routes reject. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# --- Telegram import bot ---
# Admins send the bot a CKAuto link + USD price; it publishes to the site and
# posts to the channel. Only one program may poll a bot token at a time.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (@userinfobot shows
# yours). Falls back to TELEGRAM_CHAT_ID when empty. Everyone else is ignored.
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHAT_ID=
# Where posts go. The bot must be an admin there with "Post messages".
TELEGRAM_CHANNEL_ID=@hmauctionuz
# Contact line at the bottom of every post.
TELEGRAM_CONTACT=@auctionuz_info
# Public site; posts link to $SITE_URL/products/<car id>.
SITE_URL=https://ziyo.autoauction.kr

# --- main catalogue (auction backend) ---
# Published vehicles are POSTed to $CATALOGUE_API_URL/internal/car/import,
# and USD prices are converted with its GET /currency/usd-krw rate.
# The token must equal IMPORT_API_TOKEN in the auction backend's .env.
CATALOGUE_API_URL=http://localhost:3000
CATALOGUE_IMPORT_TOKEN=
CATALOGUE_IMPORT_SOURCE=ckauto
