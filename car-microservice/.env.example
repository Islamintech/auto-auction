# --- source site ---
# See docs/ckauto-api.md. Paths default to the values below; set them only
# if CKAuto moves an endpoint.
SOURCE_BASE_URL=https://ckauto.co.kr
# SOURCE_CSRF_PATH=/api/auth/csrf
# SOURCE_LOGIN_PATH=/api/auth/login
# SOURCE_STATE_PATH=/api/app/state
# Partner account: SOURCE_USERNAME is CKAuto's loginId.
SOURCE_USERNAME=
SOURCE_PASSWORD=

# Which CKAuto statuses enter the review queue (comma-separated).
# 공매진행 = live auction (~274 lots). 낙찰대기 adds ~13k ended lots, mostly
# without photos - not recommended.
INGEST_STATUSES=공매진행
# Lots carry up to 138 photos; only the first N are copied to Cloudinary.
MAX_IMAGES_PER_VEHICLE=20

# politeness: pause after every request, including each photo
REQUEST_DELAY_MS=1500

# --- infra ---
MONGODB_URI=mongodb://localhost:27017/auto-auction
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=ckauto

# --- admin API ---
# Bearer token the admin panel presents. Min 16 chars; unset = all admin
# routes reject. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PANEL_URL=https://ziyo.autoauction.kr/admin/imports

# cron: 04:00 KST daily
INGEST_CRON=0 4 * * *

# --- main catalogue (auction backend) ---
# Approved vehicles are POSTed to $CATALOGUE_API_URL/internal/car/import.
# The token must equal IMPORT_API_TOKEN in the auction backend's .env.
CATALOGUE_API_URL=http://localhost:3000
CATALOGUE_IMPORT_TOKEN=
CATALOGUE_IMPORT_SOURCE=ckauto
