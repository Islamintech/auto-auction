{
  "name": "auto-auction",
  "version": "0.1.0",
  "description": "Telegram bot that imports chosen CKAuto lots into the after-auction platform and its channel",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "node -r ts-node/register --test test/normalizer.test.ts test/services.test.ts test/bot.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "check:login": "ts-node src/scripts/check-login.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.4.0",
    "cloudinary": "^2.5.0",
    "grammy": "^1.30.0",
    "mongoose": "^8.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stream-json": "^1.9.1",
    "tough-cookie": "^4.1.4",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/node": "^22.5.0",
    "@types/stream-json": "^1.7.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
